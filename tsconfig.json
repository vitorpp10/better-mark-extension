{
    /*
     * Build da EXTENSAO (CommonJS, carregado pelo VS Code).
     *
     * Os testes unitarios (vitest) e o config do vitest NAO entram aqui:
     * o vitest e ESM e compila os proprios testes. Ja os testes de
     * integracao (src/test) precisam ser compilados, porque o runner do
     * VS Code executa out/test/**\/*.test.js a partir deste "out".
     */
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2022",
        "outDir": "out",
        "lib": [
            "ES2022",
            "DOM"
        ],
        "types": [
            "node",
            "mocha",
        ],
        "sourceMap": true,
        "rootDir": "src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noUnusedLocals": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
    },
    "include": [
        "src/**/*.ts",
    ],
    "exclude": [
        "node_modules",
        "out",
        "src/**/__tests__/**",
    ],
}
